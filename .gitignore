# Python bytecode (e.g. from the hooks under claude/hooks/).
__pycache__/
*.pyc

# The project venv, built by `uv sync` from the committed uv.lock. Machine
# state, not source — the lockfile is what pins the contents.
.venv/

# The config-review run ledger: run-scoped scratch, deleted at close.
claude/skills/config-review/ledger.md

# Zed's prompt library, an LMDB database. The zed package links ~/.config/zed
# as a directory, so everything Zed writes there lands in this repo.
zed/zed/prompts/

# Worktrees for parallel agents, each a separate checkout of this repo.
.claude/worktrees/
