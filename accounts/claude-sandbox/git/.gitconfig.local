# Configuration specific to the claude-sandbox account, included by the shared
# ~/.gitconfig. Stowed from accounts/claude-sandbox/ only when install.sh runs
# as this account.

# Override the system-level gitconfig (Homebrew's at /opt/homebrew/etc/gitconfig
# or Xcode's, depending on which git is in use), which defaults the credential
# helper to osxkeychain. The empty string resets the helper chain before
# applying our own.
#
# We use `store` (plaintext ~/.git-credentials, mode 600) rather than
# osxkeychain because this account has no meaningful Keychain protection: the
# login keychain has an empty password and auto-unlocks, so osxkeychain would
# add opacity without encryption at rest. The real safeguard is narrowly
# scoped, fine-grained tokens, which bound the blast radius if the file leaks.
[credential]
	useHttpPath = true
	helper =
	helper = store

# This account holds no ssh key, so every GitHub URL is rewritten to https
# before git uses it. Shared repos can then record one ssh `origin` that both
# accounts read, with each account reaching it over the transport it has —
# nothing in a repo's own config has to differ per account, and a fresh clone
# needs no post-clone step.
#
# Rewriting applies to the URL git connects with, not to what `git remote -v`
# prints, which still shows the ssh URL. `git ls-remote --get-url origin` shows
# the URL actually used.
#
# The rewritten URL ends in `.git`, since that is what the canonical ssh form
# carries, and `useHttpPath` above makes that suffix part of the credential
# lookup key — so entries in ~/.git-credentials must be spelled with it.
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
